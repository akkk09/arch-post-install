#!/usr/bin/env python3
"""Reveal the pinned-app Waybar when the pointer reaches the bottom screen edge."""
from __future__ import annotations

import json
import os
import signal
import subprocess
import time
from pathlib import Path

PID_FILE = Path.home() / ".local/state/taskbar/waybar.pid"
BAR_CONFIG = Path.home() / ".config/waybar/taskbar.jsonc"
POLL_SECONDS = 0.10
BAR_HEIGHT = 42
HIDE_MARGIN = 3
EDGE_ZONE = BAR_HEIGHT + HIDE_MARGIN


def hypr_json(*args: str):
    try:
        result = subprocess.run(
            ["hyprctl", "-j", *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=1,
            check=True,
        )
        return json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return None


def taskbar_pid() -> int | None:
    try:
        pid = int(PID_FILE.read_text().strip())
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        args = [os.fsdecode(arg) for arg in raw.split(bytes([0])) if arg]
        # A stale/reused PID must never receive Waybar's visibility signal.
        if not args or Path(args[0]).name != "waybar" or str(BAR_CONFIG) not in args:
            return None
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def cursor_at_bottom(cursor: dict, monitors: list[dict]) -> bool:
    """Use the same edge zone to reveal a hidden bar and retain a visible one."""
    x, y = float(cursor["x"]), float(cursor["y"])
    for monitor in monitors:
        scale = max(float(monitor.get("scale", 1)), 0.1)
        left = float(monitor.get("x", 0))
        top = float(monitor.get("y", 0))
        width = float(monitor.get("width", 0)) / scale
        height = float(monitor.get("height", 0)) / scale
        bottom = top + height
        if left <= x <= left + width and y >= bottom - EDGE_ZONE:
            return True
    return False


def main() -> None:
    current_pid: int | None = None
    visible = True
    while True:
        pid = taskbar_pid()
        if pid is None:
            time.sleep(0.5)
            continue
        if pid != current_pid:
            current_pid = pid
            visible = True  # a newly started Waybar is visible by default
        cursor = hypr_json("cursorpos")
        monitors = hypr_json("monitors")
        if isinstance(cursor, dict) and isinstance(monitors, list):
            should_show = cursor_at_bottom(cursor, monitors)
            if should_show != visible:
                try:
                    os.kill(pid, signal.SIGUSR1)  # Waybar toggles visibility on SIGUSR1
                    visible = should_show
                except ProcessLookupError:
                    current_pid = None
        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
