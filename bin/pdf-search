#!/usr/bin/env bash
set -euo pipefail

# Search recursively for PDFs below the current directory and open the
# selected file in Zathura. Use this command from the directory you want to scan.
ROOT="$PWD"

mapfile -t pdfs < <(fd --type f --extension pdf --hidden --exclude .git . "$ROOT" | sort -f)

if ((${#pdfs[@]} == 0)); then
    echo "No PDF files found under: $ROOT" >&2
    exit 0
fi

declare -a display_names=()
declare -a display_paths=()

for pdf in "${pdfs[@]}"; do
    display_names+=( "$(basename -- "$pdf")" )
    display_paths+=( "$pdf" )
done

selected="$(printf "%s\n" "${display_names[@]}" | fuzzel --dmenu --prompt="PDF ❯ " || true)"

if [[ -n "$selected" ]]; then
    for i in "${!display_names[@]}"; do
        if [[ "${display_names[$i]}" == "$selected" ]]; then
            zathura "${display_paths[$i]}" >/dev/null 2>&1 &
            break
        fi
    done
fi
